#include <stdio.h>
#include <limits.h>

int n = 4;
int graph[4][4] = {
    {0,10,15,20},
    {10,0,35,25},
    {15,35,0,30},
    {20,25,30,0}
};

int visited[4] = {0};

int tsp(int pos, int count, int cost) {
    if (count == n && graph[pos][0]) {
        return cost + graph[pos][0];
    }

    int ans = INT_MAX;

    for (int i = 0; i < n; i++) {
        if (!visited[i] && graph[pos][i]) {
            visited[i] = 1;
            int temp = tsp(i, count + 1, cost + graph[pos][i]);
            if (temp < ans)
                ans = temp;
            visited[i] = 0;
        }
    }
    return ans;
}

int main() {
    visited[0] = 1;
    printf("Minimum Cost = %d", tsp(0, 1, 0));
    return 0;
}
