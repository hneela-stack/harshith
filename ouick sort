#include <stdio.h>
int partition(int a[],int low,int high){
    int pivot=a[low],i=low,j=high,temp;
    while(i<j){
        while(a[i]<=pivot) i++;
        while(a[j]>pivot) j--;
        if(i<j){
            temp=a[i]; a[i]=a[j]; a[j]=temp;
        }
    }
    a[low]=a[j];
    a[j]=pivot;
    return j;
}
void quick(int a[],int low,int high){
    if(low<high){
        int p=partition(a,low,high);
        quick(a,low,p-1);
        quick(a,p+1,high);
    }
}
int main(){
    int a[5]={10,7,8,9,1},i;
    quick(a,0,4);
    for(i=0;i<5;i++) printf("%d ",a[i]);
}
