#include <stdio.h>
#include <limits.h>

int main() {
    int n = 3;
    int cost[3][3] = {
        {0, 2, 3},
        {2, 0, 1},
        {3, 1, 0}
    };

    int selected[3] = {0};
    selected[0] = 1;  // Start from vertex 0

    for (int count = 0; count < n - 1; count++) {
        int min = INT_MAX;
        int x = 0, y = 0;

        for (int i = 0; i < n; i++) {
            if (selected[i]) {
                for (int j = 0; j < n; j++) {
                    if (!selected[j] && cost[i][j]) {
                        if (cost[i][j] < min) {
                            min = cost[i][j];
                            x = i;
                            y = j;
                        }
                    }
                }
            }
        }

        printf("%d - %d\n", x, y);
        selected[y] = 1;
    }

    return 0;
}
