import sys
n = 3
cost = [[0,2,3],[2,0,1],[3,1,0]]
selected = [0]*n
selected[0] = 1

for _ in range(n-1):
    min = sys.maxsize
    x=y=0
    for i in range(n):
        if selected[i]:
            for j in range(n):
                if not selected[j] and cost[i][j]:
                    if cost[i][j] < min:
                        min = cost[i][j]
                        x,y = i,j
    print(x,"-",y)
    selected[y] = 1
