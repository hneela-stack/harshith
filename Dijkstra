import sys
n=3
graph=[[0,1,4],[1,0,2],[4,2,0]]
dist=[sys.maxsize]*n
dist[0]=0
visited=[False]*n

for _ in range(n):
    u=min((d,i) for i,d in enumerate(dist) if not visited[i])[1]
    visited[u]=True
    for v in range(n):
        if graph[u][v] and not visited[v]:
            dist[v]=min(dist[v],dist[u]+graph[u][v])

print(dist)
