#include <stdio.h>
#include <limits.h>
#include <stdbool.h>

#define N 3

int main() {
    int graph[N][N] = {
        {0, 1, 4},
        {1, 0, 2},
        {4, 2, 0}
    };

    int dist[N];
    bool visited[N];

    // Initialize distances and visited array
    for (int i = 0; i < N; i++) {
        dist[i] = INT_MAX;
        visited[i] = false;
    }

    dist[0] = 0; // Source vertex

    for (int count = 0; count < N; count++) {
        int u = -1;

        // Find the unvisited node with minimum distance
        for (int i = 0; i < N; i++) {
            if (!visited[i] && (u == -1 || dist[i] < dist[u])) {
                u = i;
            }
        }

        visited[u] = true;

        // Update distances of adjacent vertices
        for (int v = 0; v < N; v++) {
            if (graph[u][v] != 0 && !visited[v] && dist[u] != INT_MAX) {
                if (dist[u] + graph[u][v] < dist[v]) {
                    dist[v] = dist[u] + graph[u][v];
                }
            }
        }
    }

    // Print result
    printf("Shortest distances from source node 0:\n");
    for (int i = 0; i < N; i++) {
        printf("%d ", dist[i]);
    }

    return 0;
}
