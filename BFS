#include <stdio.h>
int main(){
    int q[10],front=0,rear=0,visited[5]={0};
    int a[5][5],n=5;
    q[rear++]=0; visited[0]=1;
    while(front<rear){
        int v=q[front++];
        printf("%d ",v);
        for(int i=0;i<n;i++){
            if(a[v][i] && !visited[i]){
                q[rear++]=i;
                visited[i]=1;
            }
        }
    }
}
